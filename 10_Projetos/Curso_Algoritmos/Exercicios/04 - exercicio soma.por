programa
{
	//Realiza a soma simples de dois valores inteiros (X e Y)
	
	funcao inicio()
	{

		inteiro x, y, soma
		
		escreva("VALOR DE X= ")
		leia(x)
		
		escreva("VALOR DE Y= ")
		leia(y)

		soma = x + y

		escreva("TOTAL = ",soma)
	}
}
