programa
{
	//Lê o nome e a idade de duas pessoas para calcular a idade média entre elas
		
	funcao inicio()
	{
		inteiro idade1, idade2
		real media

		escreva("Digite a idade de Arthur: ")
		leia(idade1)

		escreva("Digite a idade de Livia: ")
		leia(idade2)

		media = (idade1 + idade2) / 2.0

		escreva("A idade media de Arthur e Livia e de ",media, " anos")
	}
}
